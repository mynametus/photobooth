    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  }
